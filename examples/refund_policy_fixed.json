{
  "name": "Refund policy v4 (after policyproof review)",
  "strategy": "priority",
  "decisions": ["refund", "replace", "reject", "escalate"],
  "fields": {
    "order_value":          {"type": "integer", "min": 0, "max": 200000, "unit": "INR"},
    "days_since_delivery":  {"type": "integer", "min": 0, "max": 365},
    "category":             {"type": "enum", "values": ["electronics", "fashion", "grocery", "furniture"]},
    "item_damaged":         {"type": "bool"},
    "customer_tier":        {"type": "enum", "values": ["regular", "gold"]},
    "refunds_last_90_days": {"type": "integer", "min": 0, "max": 20}
  },
  "rules": [
    {"id": "R6", "priority": 100, "source": "3.1 Three or more refunds in 90 days: always escalate first",
     "when": {"refunds_last_90_days": {"gte": 3}}, "then": "escalate"},
    {"id": "R8", "priority": 50, "source": "2.6 Damaged furniture within 3 days is replaced",
     "when": {"category": "furniture", "item_damaged": true, "days_since_delivery": {"lte": 3}}, "then": "replace"},
    {"id": "R4", "priority": 40, "source": "2.4 Undamaged returns of INR 50,000 or more need a manager",
     "when": {"item_damaged": false, "days_since_delivery": {"lte": 30}, "order_value": {"gte": 50000}},
     "then": "escalate"},
    {"id": "R1", "priority": 30, "source": "2.1 Groceries cannot be returned unless damaged",
     "when": {"category": "grocery", "item_damaged": false}, "then": "reject"},
    {"id": "R11", "priority": 30, "source": "2.7 Undamaged furniture cannot be returned (new)",
     "when": {"category": "furniture", "item_damaged": false, "order_value": {"lt": 50000}}, "then": "reject"},
    {"id": "R7", "priority": 25, "source": "4.1 Gold members get a 45-day return window",
     "when": {"customer_tier": "gold", "item_damaged": false, "days_since_delivery": {"lte": 45}},
     "then": "refund"},
    {"id": "R5", "priority": 20, "source": "2.5 No returns after 30 days",
     "when": {"days_since_delivery": {"gt": 30}}, "then": "reject"},
    {"id": "R2", "priority": 10, "source": "2.2 Damaged items reported within 7 days get a full refund",
     "when": {"item_damaged": true, "days_since_delivery": {"lte": 7}}, "then": "refund"},
    {"id": "R10", "priority": 10, "source": "2.8 Damage reported on days 8 to 30 goes to a person (new)",
     "when": {"item_damaged": true, "days_since_delivery": {"between": [8, 30]}}, "then": "escalate"},
    {"id": "R3", "priority": 10, "source": "2.3 Fashion and electronics can be returned within 30 days",
     "when": {"item_damaged": false, "days_since_delivery": {"lte": 30},
              "category": ["fashion", "electronics"], "order_value": {"lt": 50000}}, "then": "refund"}
  ]
}
